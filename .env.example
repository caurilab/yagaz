# === Contrat d'environnement Yagaz (racine monorepo) ===
# Copier en .env  ->  cp .env.example .env
# Ces valeurs alimentent docker-compose.yml. Les projets (api/web/app) ont
# aussi leur propre .env ; ils DOIVENT rester cohérents avec ces valeurs.

# --- Base de données (Postgres + TimescaleDB) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
# 5433 côté hôte pour ne pas entrer en conflit avec un PostgreSQL local sur 5432.
DB_PORT=5433
DB_DATABASE=yagaz
DB_USERNAME=yagaz
DB_PASSWORD=change_me_local

# --- Broker MQTT (Mosquitto) ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_WS_PORT=9001
# Compte de service que le worker Laravel utilise pour s'abonner :
MQTT_USERNAME=yagaz-ingest
MQTT_PASSWORD=change_me_local

# --- Redis (files d'attente) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
